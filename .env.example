# =====================================================
# AHat4Pat Hermès Pipeline — Variables d'environnement
# =====================================================
# Copier vers .env puis remplir avec tes vraies clés.
# JAMAIS commit le .env. JAMAIS partager dans le chat.

# ----- LLM -----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_KEY=                     # Pour VEO 3.1 + Gemini + Nano Banana
OPENROUTER_API_KEY=                # Backup, déjà actif chez Pat
LITELLM_URL=http://135.181.250.114:4000      # LiteLLM Paperclip VPS

# ----- Voice / Audio -----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_PAT=           # À créer après clone Pat voice (30 sec sample)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_SPEAKING_RATE=1.1       # 0.9-1.2 critique, jamais hors range
QWEN3_TTS_LOCAL_URL=               # Si déployé sur Modal

# ----- Modal Cloud GPU -----
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ----- Stock + Images -----
PEXELS_API_KEY=
FLUX_API_KEY=                      # FLUX.2 direction artistique
HIGGS_FIELD_API_KEY=               # Seedance 2.0 + GPT image 2 + Cinema Studio

# ----- YouTube -----
YOUTUBE_DATA_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ----- Patou-Overseer -----
TELEGRAM_BOT_TOKEN_PATOU=
TELEGRAM_CHAT_ID_PAT=
DRY_RUN=1                          # 1 par défaut, mettre 0 quand validé 48h

# ----- Cloudflare R2 -----
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ahat4pat-pipeline
R2_ENDPOINT_URL=

# ----- Hetzner Beck VPS (si on bascule sur self-hosted) -----
BECK_SSH_HOST=65.109.135.115
BECK_SSH_USER=root
BECK_SSH_KEY_PATH=~/.ssh/id_ed25519

# ----- n8n -----
N8N_URL=http://localhost:5678
N8N_API_KEY=

# ----- Composio (pour Outlook + autres) -----
COMPOSIO_API_KEY=

# ----- Newsletter / KDP -----
BEEHIIV_API_KEY=
KDP_AMAZON_ACCESS=                 # via Composio si dispo

# ----- Affiliate -----
PAYKICKSTART_API_KEY=              # Optionnel, si on choisit PayKickstart
CLICKBANK_NICKNAME=                # Pour CTR tracking
BITLY_API_KEY=                     # Cleanup URLs

# ----- Voice services (post launch) -----
VAPI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ----- Brand / Branding -----
BRAND_NAME=AHat4Pat
BRAND_COLOR_PRIMARY=#d97706
BRAND_COLOR_ACCENT=#1e293b
BRAND_EMAIL=contact@ahat4pat.com
PAT_PERSONAL_EMAIL=ahat4pat@gmail.com
